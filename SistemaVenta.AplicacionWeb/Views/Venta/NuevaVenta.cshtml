
@{
    ViewData["Title"] = "NuevaVenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="~/vendor/select2/select2.min.css" rel="stylesheet">

    <style>
        .select2{
            width: 100% !important;
        }
    </style>
}

<div class="row">
    <div class="col-lg-8 col-md-12 mb-4 mb-lg-0">
        <div class="row">
            <div class="col-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 bg-header-black d-flex align-items-center">
                        <i class="fas fa-user mr-2 text-white" style="opacity: 0.7;"></i>
                        <h6 class="m-0 font-weight-bold text-white">Cliente</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-6 col-12">
                                <label for="txtDocumentoCliente">N° Documento</label>
                                <input id="txtDocumentoCliente"
                                    type="text" 
                                    class="form-control form-control-sm" 
                                    placeholder="numero documento" maxlength="13">
                            </div>
                            <div class="form-group col-md-6 col-12">
                                <label for="txtNombreCliente">Nombre Completo</label>
                                <input id="txtNombreCliente"
                                    type="text" 
                                    class="form-control form-control-sm" 
                                    placeholder="nombre completo" maxlength="50">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 bg-header-black d-flex align-items-center">
                        <i class="fas fa-boxes mr-2 text-white" style="opacity: 0.7;"></i>
                        <h6 class="m-0 font-weight-bold text-white">Productos</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-12">
                                <label>Buscar producto</label>
                                <select class="form-control form-control-sm" id="cboBuscarProducto">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-sm" id="tbProducto">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-12">
        <div class="row">
            <div class="col-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 bg-header-black d-flex align-items-center">
                        <i class="fas fa-file-invoice-dollar mr-2 text-white" style="opacity: 0.7;"></i>
                        <h6 class="m-0 font-weight-bold text-white">Detalle</h6>
                    </div>
                    <div class="card-body">
                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <label class="input-group-text" for="cboTipoDocumentoVenta">Tipo</label>
                            </div>
                            <select class="custom-select" id="cboTipoDocumentoVenta">
                            </select>
                        </div>
                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="inputGroupSubTotal">Sub Total</span>
                            </div>
                            <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupSubTotal" id="txtSubTotal" disabled>
                        </div>
                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="inputGroupITBIS">ITBIS (18%)</span>
                            </div>
                            <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupITBIS" id="txtITBIS" disabled>
                        </div>
                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="inputGroupTotal">Total</span>
                            </div>
                            <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupTotal" id="txtTotal" disabled>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="form-group mb-0">
                            <button class="btn btn-success btn-block" id="btnTerminarVenta">
                                <i class="fas fa-check-circle mr-1"></i> Terminar Venta
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- ============================================================
    =SCRIPTS PARA ESTA PAGINA
    ===============================================================-->
    <script src="~/vendor/select2/select2.min.js"></script>
    <script src="~/vendor/select2/es.min.js"></script>
    <script src="~/js/vistas/NuevaVenta_Index.js"></script>
}