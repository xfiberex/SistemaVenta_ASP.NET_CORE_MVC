@model SistemaVenta.AplicacionWeb.Models.ViewModels.VMUsuarioLogin;
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>FiberTech - Restablecer Clave</title>
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Nunito:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
    <link href="~/css/sb-admin-2.css" rel="stylesheet">
    <link href="~/css/OtrosEstilos.css" rel="stylesheet">
</head>

<body class="bg-gradient-info-black">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-12 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-4 my-md-5" style="border-radius: 0.75rem; overflow: hidden;">
                    <div class="card-body p-0">
                        <div class="row no-gutters">
                            <div class="col-lg-6 d-none d-lg-block bg-password-image-gaming"></div>
                            <div class="col-lg-6">
                                <div class="p-4 p-md-5">
                                    <div class="text-center mb-4">
                                        <div class="mb-3">
                                            <i class="fas fa-key fa-2x" style="color: var(--ft-primary);"></i>
                                        </div>
                                        <h1 class="h4 mb-1" style="font-weight: 700; color: var(--ft-text-primary);">¿Olvidó su contraseña?</h1>
                                        <p class="small" style="color: var(--ft-text-secondary);">Ingrese su correo de sesión y le enviaremos una nueva contraseña</p>
                                    </div>
                                    <form class="user" asp-controller="Acceso" asp-action="RestablecerClave" method="post">
                                        <div class="form-group">
                                            <label class="small" style="font-weight: 600; color: var(--ft-text-secondary);">Correo electrónico</label>
                                            <input type="email" class="form-control form-control-user" asp-for="Correo" placeholder="correo@ejemplo.com">
                                        </div>
                                        @if (ViewData["Mensaje"] != null)
                                        {
                                            <div class="form-group">
                                                <div class="alert alert-success" role="alert">
                                                    <i class="fas fa-check-circle mr-1"></i> @ViewData["Mensaje"]
                                                </div>
                                            </div>
                                        }
                                        @if (ViewData["MensajeError"] != null)
                                        {
                                            <div class="form-group">
                                                <div class="alert alert-danger" role="alert">
                                                    <i class="fas fa-exclamation-circle mr-1"></i> @ViewData["MensajeError"]
                                                </div>
                                            </div>
                                        }
                                        @if (ViewData["MensajeCampoVacio"] != null)
                                        {
                                            <div class="form-group">
                                                <div class="alert alert-danger" role="alert">
                                                    <i class="fas fa-exclamation-circle mr-1"></i> @ViewData["MensajeCampoVacio"]
                                                </div>
                                            </div>
                                        }

                                        <button type="submit" class="btn btn-primary btn-user btn-block">
                                            <i class="fas fa-paper-plane mr-1"></i> Restablecer Contraseña
                                        </button>
                                    </form>
                                    <hr>
                                    <div class="text-center">
                                        <a class="small" href="@Url.Action("Login", "Acceso")" style="color: var(--ft-primary); font-weight: 500;">
                                            <i class="fas fa-arrow-left mr-1"></i> Volver a Iniciar Sesión
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>